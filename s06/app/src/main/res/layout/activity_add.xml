<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TextView: titlul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titlu_adaugare"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- TextView (etichetă) + EditText -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/eticheta_nume" />

        <EditText
            android:id="@+id/nume_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nume"
            android:inputType="text" />

        <!-- Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/eticheta_oras" />

        <Spinner
            android:id="@+id/oras_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/orase" />

        <!-- RadioButton-uri -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/eticheta_tip" />

        <RadioGroup
            android:id="@+id/tip_rg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tip_cafenea_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tip_cafenea" />

            <RadioButton
                android:id="@+id/tip_pub_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_pub" />

            <RadioButton
                android:id="@+id/tip_club_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_club" />
        </RadioGroup>

        <!-- CheckBox -->
        <CheckBox
            android:id="@+id/terasa_cb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/are_terasa" />

        <!-- Switch -->
        <Switch
            android:id="@+id/nonstop_sw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/non_stop"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <!-- RatingBar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/eticheta_rating" />

        <RatingBar
            android:id="@+id/rating_rb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5" />

        <!-- EditText numeric -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/eticheta_pret" />

        <EditText
            android:id="@+id/pret_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_pret"
            android:inputType="number" />

        <!-- Button -->
        <Button
            android:id="@+id/salveaza_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:onClick="salveazaBar"
            android:text="@string/salveaza" />

    </LinearLayout>
</ScrollView>